<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} - {% endif %}Warrior * Sorcerer * Rogue</title>
    <link rel="stylesheet" href="{{ '/css/book.css' | url }}">
    <link rel="stylesheet" href="{{ '/pagefind/pagefind-ui.css' | url }}">
    <script src="{{ '/pagefind/pagefind-ui.js' | url }}"></script>
  </head>
  <body>
    <header class="site-header">
      <button class="nav-toggle" type="button" aria-label="Toggle table of contents" aria-controls="sidebar" aria-expanded="false">
        <span class="bars" aria-hidden="true"></span>
      </button>
      <a class="site-title" href="{{ '/' | url }}">Warrior <span class="sep">*</span> Sorcerer <span class="sep">*</span> Rogue</a>
      <div id="search"></div>
    </header>

    <div class="app">
      {% set thisSlug = page.fileSlug %}

      <aside id="sidebar" class="sidebar" aria-label="Table of contents">
        <nav class="sidebar-nav">
          <ul class="chapters">
            {% for c in chapters %}
              {% set isActive = (c.slug == thisSlug) %}
              <li class="chapter-item">
                <div class="chapter-row{% if isActive %} active{% endif %}">
                  <button class="toggle" type="button" aria-expanded="{% if isActive %}true{% else %}false{% endif %}" aria-controls="ch-{{ c.slug }}" aria-label="Toggle {{ c.title }} sections">
                    <span class="chevron" aria-hidden="true">▸</span>
                  </button>
                  <a class="chapter-link" href="{{ ('/' + c.slug + '/') | url }}">
                    <span class="num">{{ c.num }}</span>
                    <span class="title">{{ c.title }}</span>
                  </a>
                </div>
                {% if c.sections.length %}
                  <ul id="ch-{{ c.slug }}" class="sections"{% if not isActive %} hidden{% endif %}>
                    {% for s in c.sections %}
                      {% if s.level == 2 %}
                        <li>
                          <a href="{{ ('/' + c.slug + '/#' + s.id) | url }}">
                            <span class="num">{{ s.num }}</span>
                            <span class="title">{{ s.title }}</span>
                          </a>
                        </li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>
      </aside>

      <div class="sidebar-backdrop" aria-hidden="true"></div>

      <main class="content">
        {{ content | safe }}
      </main>
    </div>

    <footer class="site-footer">
      <p>
        Warrior * Sorcerer * Rogue is built on Chaosium's Basic Roleplaying
        Universal Game Engine under the ORC License.
        <a href="{{ '/p01-introduction/#sec-5-1' | url }}">Attribution.</a>
      </p>
    </footer>

    <script>
      (function () {
        // Pagefind search UI.
        if (window.PagefindUI) {
          new PagefindUI({
            element: "#search",
            showSubResults: true,
            showImages: false,
          });
        }

        // Collapsible chapter toggles in the sidebar.
        document.querySelectorAll(".sidebar .toggle").forEach(function (btn) {
          btn.addEventListener("click", function (e) {
            e.preventDefault();
            var expanded = btn.getAttribute("aria-expanded") === "true";
            var target = document.getElementById(btn.getAttribute("aria-controls"));
            btn.setAttribute("aria-expanded", expanded ? "false" : "true");
            if (target) target.hidden = expanded;
          });
        });

        // Mobile sidebar slide-in toggle.
        var navToggle = document.querySelector(".nav-toggle");
        var sidebar = document.getElementById("sidebar");
        var backdrop = document.querySelector(".sidebar-backdrop");
        function setOpen(open) {
          if (!sidebar) return;
          sidebar.classList.toggle("open", open);
          if (backdrop) backdrop.classList.toggle("visible", open);
          if (navToggle) navToggle.setAttribute("aria-expanded", open ? "true" : "false");
        }
        if (navToggle) {
          navToggle.addEventListener("click", function () {
            setOpen(!sidebar.classList.contains("open"));
          });
        }
        if (backdrop) {
          backdrop.addEventListener("click", function () { setOpen(false); });
        }
      })();
    </script>
  </body>
</html>
